# pocketSearch environment configuration
# Copy this file to .env and fill in values before running.

# Required: generate with `python -c 'import secrets; print(secrets.token_hex(32))'`
SECRET_KEY=change-this-to-a-random-secret-key

# Optional: database path (default: webscope.db)
DB_PATH=webscope.db

# Optional: request timeout in seconds (default: 8)
TIMEOUT=8

# Optional: max response body size in bytes (default: 5242880)
MAX_BODY_BYTES=5242880

# Optional: recon cache TTL in hours (default: 24)
RECON_CACHE_HOURS=24

# Optional: debug mode (default: false)
DEBUG=false

# Optional: preferred domain for search (default: kitpocket.it.com)
PREFERRED_DOMAIN=kitpocket.it.com

# Optional: host and port (defaults: 0.0.0.0 / 5000)
HOST=0.0.0.0
PORT=5000

# Optional: email for OpenAlex API (required by OpenAlex policy)
OPENALEX_MAILTO=webscope@example.com

# Optional: knowledge cache database path (default: knowledge_cache.db)
KNOWLEDGE_CACHE_DB=knowledge_cache.db