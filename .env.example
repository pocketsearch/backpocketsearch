# pocketSearch environment configuration
# Copy this file to .env and fill in values before running.

# Required: generate with `python -c 'import secrets; print(secrets.token_hex(32))'`
SECRET_KEY=change-this-to-a-random-secret-key

# Application environment: production, development, or testing (default: production)
FLASK_ENV=production

# Database configuration
DB_PATH=webscope.db
KNOWLEDGE_CACHE_DB=knowledge_cache.db

# Server configuration
HOST=0.0.0.0
PORT=5000

# Request configuration (in seconds)
TIMEOUT=8
MAX_BODY_BYTES=5242880

# Caching and history
RECON_CACHE_HOURS=24
HISTORY_DAYS=30
VACUUM_INTERVAL_HOURS=1

# Debug mode (only for development: true/false, default: false)
DEBUG=false

# Logging level (DEBUG, INFO, WARNING, ERROR, default: INFO)
LOG_LEVEL=INFO

# Optional: preferred domain for search
PREFERRED_DOMAIN=kitpocket.it.com

# Optional: email for OpenAlex API (required by OpenAlex policy)
OPENALEX_MAILTO=webscope@example.com